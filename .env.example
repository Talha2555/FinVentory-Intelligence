# Export these variables in your shell; the app does not auto-load .env files.
PGHOST=localhost
PGPORT=5432
PGDATABASE=finventory_db
PGUSER=finventory_app
PGPASSWORD=replace-with-your-local-password
# For remote servers use PGSSLMODE=verify-full and configure PGSSLROOTCERT.
# DATABASE_URL takes precedence over PG* connection values.
# FINVENTORY_USERS_FILE=/absolute/private/path/users.csv
